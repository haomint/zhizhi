{
  "name": "zhizhi-personal",
  "version": "1.1.0",
  "private": true,
  "description": "知枝个人学习助手：React + TypeScript + Pi，Android 本地运行",
  "scripts": {
    "dev": "npm run assets && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-assets.ts",
    "build": "npm run typecheck && npm run assets && vite build && node scripts/write-build-info.ts",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/test-browser.ts",
    "check": "npm run format:check && npm test && npm run build && npm run doctor",
    "preview": "vite preview --host 0.0.0.0 --strictPort",
    "android:sync": "npm run build && cap sync android",
    "android:build": "python3 scripts/build_android.py",
    "doctor": "node scripts/doctor.ts",
    "format": "prettier --write src scripts/*.ts vite.config.ts tests/*.mjs",
    "format:check": "prettier --check src scripts/*.ts vite.config.ts tests/*.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
